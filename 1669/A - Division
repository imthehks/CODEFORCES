#include <iostream>
using namespace std;
 
int main()
{
 
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t{};
    cin >> t;
 
    while (t--)
    {
        int n{};
        cin >> n;
        if (n >= 1900)
            cout << "Division 1" << endl;
        else if (1600 <= n && n <= 1899)
            cout << "Division 2" << endl;
        else if (1400 <= n && n <= 1599)
            cout << "Division 3" << endl;
        else
            cout << "Division 4" << endl;
    }
    return 0;
}